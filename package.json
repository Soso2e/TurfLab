{
  "name": "turflab",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-tool.mjs vite --config apps/web/vite.config.ts",
    "dev:api": "wrangler dev --config workers/api/wrangler.jsonc",
    "build": "node scripts/run-tool.mjs vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node scripts/run-tool.mjs vitest run",
    "test:watch": "node scripts/run-tool.mjs vitest",
    "benchmark": "tsx scripts/benchmark.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "generate:schema": "tsx scripts/generate-schema.ts",
    "format": "prettier --write .",
    "test:runtime": "node scripts/run-tool.mjs tsx scripts/runtime-smoke.ts",
    "generate:d1": "tsx scripts/generate-d1.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261011.1",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
