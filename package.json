{
  "name": "turflab",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-tool.mjs vite --config apps/web/vite.config.ts",
    "dev:api": "wrangler dev --config workers/api/wrangler.jsonc",
    "build": "node scripts/run-tool.mjs vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node scripts/run-tool.mjs vitest run",
    "test:watch": "node scripts/run-tool.mjs vitest",
    "benchmark": "tsx scripts/benchmark.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "generate:schema": "tsx scripts/generate-schema.ts",
    "format": "prettier --write .",
    "test:runtime": "node scripts/run-tool.mjs tsx scripts/runtime-smoke.ts",
    "test:wizard": "node scripts/run-tool.mjs tsx scripts/wizard-smoke.ts",
    "test:bridge": "node scripts/run-tool.mjs tsx scripts/bridge-smoke.ts",
    "test:hra": "node scripts/run-tool.mjs tsx scripts/horse-result-analysis-smoke.ts",
    "boatrace:verify": "node scripts/run-tool.mjs tsx scripts/boatrace-verify.ts",
    "c2:status": "node scripts/run-tool.mjs tsx scripts/c2-status.ts",
    "predictions:local": "node scripts/run-tool.mjs tsx scripts/local-predictions.ts",
    "odds:import": "node scripts/run-tool.mjs tsx scripts/nar-odds-cli.ts import",
    "odds:report": "node scripts/run-tool.mjs tsx scripts/nar-odds-cli.ts report",
    "stats:digest": "node scripts/run-tool.mjs tsx scripts/stats-digest.ts",
    "nar:check": "node scripts/run-tool.mjs tsx scripts/nar-csv-check.ts",
    "python:analyze": "python scripts/python/analyze_history.py",
    "results:import": "tsx scripts/import-all-missing-results.ts",
    "keiba:results": "node scripts/run-tool.mjs tsx scripts/keiba-results-cli.ts",
    "learning:report": "node scripts/run-tool.mjs tsx scripts/learning-report.ts",
    "generate:d1": "tsx scripts/generate-d1.ts",
    "forecast:lock": "node scripts/run-tool.mjs tsx scripts/forecast-eval-cli.ts lock",
    "forecast:result": "node scripts/run-tool.mjs tsx scripts/forecast-eval-cli.ts result",
    "forecast:report": "node scripts/run-tool.mjs tsx scripts/forecast-eval-cli.ts report",
    "forecast:backtest": "python scripts/python/forecast_lab/cli.py backtest",
    "forecast:predict": "python scripts/python/forecast_lab/cli.py predict",
    "trackday:audit": "python scripts/python/forecast_lab/track_day_cli.py audit",
    "trackday:backfill": "python scripts/python/forecast_lab/track_day_cli.py backfill",
    "trackday:evaluate": "python scripts/python/forecast_lab/track_day_cli.py evaluate",
    "trackday:stage-nar": "python scripts/python/forecast_lab/track_day_cli.py stage-nar",
    "trackday:sync": "python scripts/python/forecast_lab/track_day_cli.py sync",
    "trackday:ingest": "python scripts/python/forecast_lab/track_day_cli.py ingest",
    "forecast:pytest": "python -m unittest discover -s scripts/python -t scripts/python -p \"test_*.py\""
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "cheerio": "^1.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261011.1",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "cheerio": { "undici": "^7.30.2" }
  }
}
